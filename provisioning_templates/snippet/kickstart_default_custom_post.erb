<%#
name: Kickstart default custom post
description: This adds users from admin_users and runs a finisher script from zfs1
snippet: true
model: ProvisioningTemplate
organizations:
- Gonoph
locations:
- Home
parameters:
- custom_adhoc_post_command: adhoc command to run during post
-%>
<% if host_param('admin_users') -%>
for user in <%= host_param('admin_users') %> ; do
    if getent passwd $user ; then
        echo "$user already exists!"
    else
        useradd $user || true
    fi
    home_dir=$(getent passwd "$user" | cut -d: -f6)
    if test -d "$home_dir" ; then
      echo "dir: $home_dir is already there."
    else
      if test -n "$home_dir" ; then
        echo "$home_dir not there, but user was created. creating again..."
        mkdir -p "$home_dir"
        chown $user:$user "$home_dir"
        chmod 700 "$home_dir"
      else
        echo "'$home_dir' is blank-ish, not creating..."
      fi
    fi
    usermod -a -G wheel $user || true
    echo "$user ALL=(ALL)	NOPASSWD: ALL" > /etc/sudoers.d/01-$user || true
done
restorecon -Rv /etc/sudoers.d
restorecon -Rv /home
<% else -%>
echo "admin_users is not defined! No users to add!"
<% end -%>
<% if host_param('custom_adhoc_post_command') -%>
(
<%= host_param('custom_adhoc_post_command') %>
) || true
<% end -%>
subscription-manager facts --update
dnf uploadprofile --force-upload
